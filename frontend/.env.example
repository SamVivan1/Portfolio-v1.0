# Server-side GitHub token for /api/github (recommended).
GITHUB_TOKEN=

# Canonical production origin, used at build time for metadata, OG, and sitemap.
NEXT_PUBLIC_SITE_URL=https://samvivan.my.id

# Optional privacy-friendly analytics (Umami-compatible).
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Legacy fallback; prefer GITHUB_TOKEN.
NEXT_PUBLIC_GITHUB_TOKEN=
